# Environment variables for Finland Job Market Visualizer

# ── AI-exposure scoring backend ────────────────────────────────────────────
# auto (default) = Claude if ANTHROPIC_API_KEY is set, else Vertex AI if
# VERTEX_PROJECT is set, else Google AI Studio. Or pin one:
# anthropic | vertex | aistudio
LLM_BACKEND=anthropic

# ── Option A: Claude API (Anthropic) ───────────────────────────────────────
# Get your API key from https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
#
# Claude Haiku 5.5 is the cheapest and fastest Claude model; scoring all
# ~460 occupations costs roughly $0.10-0.20.
CLAUDE_MODEL=claude-haiku-5-5

# ── Option B: Google AI Studio (free tier) ─────────────────────────────────
# Get your API key from https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# ── Option C: Vertex AI (Google Cloud credits) ─────────────────────────────
# Your GCP project ID (find it in Google Cloud Console)
VERTEX_PROJECT=project ID
#
# API key from GCP Console → APIs & Services → Credentials → Create API key
# (restricts to Vertex AI API for safety)
VERTEX_API_KEY=key
#
# Region to use (default: us-central1). For EU data residency use:
# europe-west4 (Netherlands) or europe-west1 (Belgium)
VERTEX_LOCATION=europe-west4
#
# With LLM_BACKEND=auto, Vertex AI is used when VERTEX_PROJECT is set and no
# ANTHROPIC_API_KEY is;
# API key is used when VERTEX_API_KEY is also set (no gcloud login needed).

# ── Gemini model (Options B and C) ─────────────────────────────────────────
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
LLM_MODEL=gemini-2.5-flash

# ── Output paths ───────────────────────────────────────────────────────────
SCORES_OUTPUT_FILE=data/scores.json

# ── Optional: Treemap hierarchy level (default: 4) ─────────────────────────
TREE_LEVEL=4