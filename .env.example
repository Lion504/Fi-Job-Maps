# Environment variables for Finland Job Market Visualizer

# Required for AI exposure scoring (score.py)
# Get your API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# LLM Model configuration (default: gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-pro, etc.
LLM_MODEL=gemini-2.0-flash

# Output file for scores (relative to project root)
SCORES_OUTPUT_FILE=data/scores.json

# Optional: Choose hierarchy level for treemap (default: 4)
# TREE_LEVEL=4
