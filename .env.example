# Environment variables for Finland Job Market Visualizer

# ── Option A: Google AI Studio (free tier) ─────────────────────────────────
# Get your API key from https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# ── Option B: Vertex AI (Google Cloud credits) ─────────────────────────────
# Your GCP project ID (find it in Google Cloud Console)
VERTEX_PROJECT=project ID
#
# API key from GCP Console → APIs & Services → Credentials → Create API key
# (restricts to Vertex AI API for safety)
VERTEX_API_KEY=key
#
# Region to use (default: us-central1). For EU data residency use:
# europe-west4 (Netherlands) or europe-west1 (Belgium)
VERTEX_LOCATION=europe-west4
#
# Vertex AI is preferred (auto) when VERTEX_PROJECT is set,
# API key is used when VERTEX_API_KEY is also set (no gcloud login needed).

# ── LLM Model ──────────────────────────────────────────────────────────────
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
LLM_MODEL=gemini-2.5-flash

# ── Output paths ───────────────────────────────────────────────────────────
SCORES_OUTPUT_FILE=data/scores.json

# ── Optional: Treemap hierarchy level (default: 4) ─────────────────────────
TREE_LEVEL=4